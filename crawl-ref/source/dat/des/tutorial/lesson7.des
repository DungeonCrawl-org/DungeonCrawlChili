##############################################
# Tutorial map 7: Threat Assessment and       #
#                Stairdancing                 #
##############################################

{{
crawl_require("dlua/tutorial.lua")
tutorial7 = {}
function tutorial7.msg(text)
    return tutorial_msg("tutorial7 " .. text)
end
function tutorial7.exit()
    crawl.tutorial_msg("tutorial7 exit", true)
end
function tutorial7.win()
    crawl.mark_game_won()
    return tutorial7.exit()
end
}}

NAME:    tutorial_lesson7
TAGS:    no_rotate no_monster_gen no_item_gen no_hmirror no_vmirror no_trap_gen no_pool_fixup tutorial
DESC:    Lesson 7: Threat Assessment and Stairdancing
ORDER:   7
ORIENT:  encompass
KFEAT:   ABCD = .
COLOUR:  ABCD = lightblue
FTILE:   ABCD = tutorial_pad
KITEM:   h = potion of heal wounds q:2 pre_id
KITEM:   s = potion of haste q:1 pre_id
KITEM:   f = scroll of fog q:1 pre_id
KITEM:   p = wand of polymorph charges:5 pre_id
MARKER:  A = lua:tutorial7.msg("start")
MARKER:  B = lua:tutorial7.msg("supplies")
MARKER:  } = lua:tutorial7.msg("downstairs")
MARKER:  { = lua:one_way_stair { dst = "tutorial_lesson7", \
                                 desc = "leave the tutorial early", \
                                 onclimb = "tutorial7.exit" }
epilogue{{
  if crawl.game_started() then
    crawl.clear_messages(true)
    crawl.tutorial_msg("tutorial7 start")
    tutorial_intro()
  end
}}
